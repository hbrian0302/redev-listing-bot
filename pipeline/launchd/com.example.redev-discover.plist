<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.redev-discover</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd ~/agents/telegram-claude &amp;&amp; /Users/USER/.local/bin/uv run --with jinja2 --with keyring python "/path/to/repo/pipeline/discover.py"</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/path/to/repo/pipeline/discover.log</string>
  <key>StandardErrorPath</key><string>/path/to/repo/pipeline/discover.error.log</string>
</dict></plist>
