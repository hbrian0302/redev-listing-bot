<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.musunwi-publish</string>
  <key>ProgramArguments</key><array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd ~/agents/telegram-claude &amp;&amp; /Users/USER/.local/bin/uv run --with keyring python "/path/to/repo/무순위/publish.py" --count 2</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/path/to/repo/무순위/publish.log</string>
  <key>StandardErrorPath</key><string>/path/to/repo/무순위/publish.error.log</string>
</dict></plist>
